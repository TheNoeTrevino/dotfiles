[Unit]
Description=PostgreSQL SSH tunnel to geekom (localhost:15432 -> geekom:5432)
Documentation=man:ssh(1)
# Keep retrying forever: at boot tailscale/network may not be up yet, and a
# dropped link should always reconnect. RestartSec spaces attempts out; disabling
# the start-rate limit means systemd never gives up.
StartLimitIntervalSec=0

[Service]
Type=simple
# -N (no remote command); the LocalForward + ServerAliveInterval/ExitOnForwardFailure
# live on the `geekom` host block in ~/.ssh/config, so this stays the single source
# of truth and a manual `ssh geekom` forwards identically.
ExecStart=/usr/bin/ssh -N geekom
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
