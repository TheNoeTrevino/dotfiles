# ~/.config/git holds the global git config, now that ~/.gitconfig is gone.
# config and ignore are portable, so they are tracked. config-work carries a
# work email and this repo is public, so it stays out. Git ignores a missing
# includeIf path without complaining, so the include in config is harmless on a
# machine that has no config-work.
/git/config-work

# herdr keeps its runtime state next to config.toml. Track only the config.
/herdr/*.log
/herdr/*.sock
/herdr/session.json
/herdr/.plugins.lock
/herdr/plugins/
/herdr/sessions/
# Generated by `herdr plugin install`: absolute paths, a hashed plugin dir and
# an install timestamp. It also caches the manifest, so it goes stale whenever
# the manifest is edited. herdr reads the manifest itself, not this file.
/herdr/plugins.json
/libreoffice/4/cache/sifr_dark/200
/herdr/release-notes.json
